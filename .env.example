# Namespace for a local installation, independent of older weightbox containers.
COMPOSE_PROJECT_NAME=weightbox-local

# Copy to .env; replace this local example password before use.
# Compose shares these connection parts with db, etl, and frontend.
# No duplicate DSNs to keep in sync; special characters are escaped by clients.
POSTGRES_USER=weightbox_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=weightbox

# Host-only ports. Container connections always use db:5432.
POSTGRES_HOST_PORT=5432
FRONTEND_PORT=3000

# ETL: CSVs are mounted read-only at /app/csv.
ETL_CSV_MODELS_PATH=/app/csv/notable_ai_models.csv
ETL_CSV_GPUS_PATH=/app/csv/gpu_specs_v7.csv
ETL_BATCH_SIZE=5000
ETL_SKIP_ODS_IF_LOADED=true
ETL_FAIL_FAST=true
ETL_LOG_LEVEL=INFO

# Tests use the separate Compose test-db automatically.
# Host-side pytest may instead use TEST_DATABASE_URL for a throwaway DB only.
