# PostgreSQL (the db container reads POSTGRES_*; the ETL reads all of it)
POSTGRES_USER=weightbox_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=weightbox
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Connection URLs
DATABASE_URL=postgresql+psycopg://weightbox_admin:change_me@db:5432/weightbox
PG_DSN=postgresql://weightbox_admin:change_me@db:5432/weightbox

# ETL
ETL_CSV_MODELS_PATH=/app/csv/notable_ai_models.csv
ETL_CSV_GPUS_PATH=/app/csv/gpu_specs_v7.csv
ETL_BATCH_SIZE=5000
ETL_SKIP_ODS_IF_LOADED=true
ETL_FAIL_FAST=true
ETL_LOG_LEVEL=INFO

# Tests: point integration tests at an existing throwaway DB.
# Leave blank to let testcontainers start one (needs Docker).
TEST_DATABASE_URL=
